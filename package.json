{
  "name": "lolzteam-api-ts",
  "version": "1.0.1",
  "description": "TypeScript and JavaScript SDK for the LOLZTEAM Forum and Market APIs, generated from the official OpenAPI documents.",
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "codegen:forum": "ts-node codegen/generate.ts --schema codegen/schemas/forum.json --output src/forum/_generated.ts --class ForumAPI",
    "codegen:market": "ts-node codegen/generate.ts --schema codegen/schemas/market.json --output src/market/_generated.ts --class MarketAPI",
    "codegen": "npm run codegen:forum && npm run codegen:market",
    "docs": "node scripts/api-reference.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "build": "npm run clean && tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json && node scripts/postbuild.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "sync-version": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "lolzteam",
    "lolz",
    "lolzteam-api",
    "zelenka",
    "lzt",
    "lzt-market",
    "zt-market",
    "api",
    "sdk",
    "client",
    "wrapper",
    "typescript"
  ],
  "author": "liwidale",
  "license": "MIT",
  "homepage": "https://github.com/liwidale/lolzteam-api-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liwidale/lolzteam-api-ts.git"
  },
  "bugs": {
    "url": "https://github.com/liwidale/lolzteam-api-ts/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "undici": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  }
}
